# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local environments and secrets
.venv/
venv/
.env
.env.*
!.env.example

# Downloaded datasets and generated caches
/data/*
!/data/lift/
!/data/pusht/
/data/lift/*
/data/pusht/*
!/data/lift/lift_act/
/data/lift/lift_act/*
!/data/lift/lift_act/splits.json
!/data/lift/lift_act/act_source_commit.txt
!/data/lift/lift_act/stats_train_20.json
!/data/lift/lift_act/stats_train_50.json
!/data/pusht/.gitkeep

# Generated results, videos, and checkpoints
/outputs/*
!/outputs/lift/
!/outputs/pusht/
/outputs/lift/*
/outputs/pusht/*
!/outputs/lift/.gitkeep
!/outputs/pusht/.gitkeep
/assets/

*.pt
*.pth
*.ckpt

# Runtime logs
*.log

# Temporary files and editor backups
*.tmp
*.bak
*.swp
*.swo
*~

# Native crash dumps
core
core.*
*.core

# Downloaded upstream ACT repository
/third_party/lift/act/

# Earlier document snapshots
*.previous

# Editable package metadata and builds
*.egg-info/
build/
dist/
